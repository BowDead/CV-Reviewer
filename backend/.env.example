PORT=3001
# Klucz z https://console.groq.com/keys
GROQ_API_KEY=

# Model Groq (lista: https://console.groq.com/docs/models)
GROQ_MODEL=openai/gpt-oss-120b

# Sekret do podpisywania tokenów logowania (min. 32 znaki). Wygeneruj:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# Klucz główny szyfrujący klucze danych użytkowników (32 bajty w base64url). Wygeneruj tak samo.
# Jego utrata albo zmiana oznacza utratę wszystkich zaszyfrowanych danych.
MASTER_KEY=

# DATABASE_URL ustawia compose.yaml (host "db" istnieje tylko w sieci Dockera)


# Opcjonalny token GitHub (podnosi limit z 60 do 5000 zapytań na godzinę).
# Utworzysz go na https://github.com/settings/personal-access-tokens (Fine-grained, Public repositories, bez uprawnień).
GITHUB_TOKEN=
